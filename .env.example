# NexaChat Bot Token from @BotFather
BOT_TOKEN=
# Or when sharing root .env:
BOT_TOKEN_CHAT=

# Groq Cloud API Key (100% Free at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Administrator IDs (comma-separated Telegram user IDs)
ADMIN_IDS=5831301324

# Quota & Monetization
DAILY_LIMIT_CHAT=15
VIP_PRICE_STARS=50
REFERRALS_FOR_VIP=3

# Database URL (leave empty for SQLite shared_empire.db)
DATABASE_URL=
